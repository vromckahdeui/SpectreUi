            end)
        end

        function Elements:AddSlider(labelText, current, max, callback)
            local currentIndex = BoxFrame:GetAttribute("OrderIndex") or 1
            BoxFrame:SetAttribute("OrderIndex", currentIndex + 2)

            local cb = callback or function() end
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 11)
            lbl.BackgroundTransparency = 1
            lbl.Text = labelText
            lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
            lbl.Font = Enum.Font.Arcade
            lbl.TextSize = 10 
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.LayoutOrder = currentIndex
            lbl.ZIndex = 2
            lbl.Parent = BoxFrame

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 9)
            track.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
            track.BorderColor3 = Color3.fromRGB(32, 32, 35)
            track.LayoutOrder = currentIndex + 1
            track.ZIndex = 2
            track.Parent = BoxFrame

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(current/max, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(130, 85, 230)
            fill.BorderSizePixel = 0
            fill.ZIndex = 2
            fill.Parent = track

            local val = Instance.new("TextLabel")
            val.Size = UDim2.new(1, -4, 1, 0)
            val.BackgroundTransparency = 1
            val.Text = current .. "/" .. max
            val.TextColor3 = Color3.fromRGB(150, 150, 155)
            val.Font = Enum.Font.Arcade
            val.TextSize = 9 
            val.TextXAlignment = Enum.TextXAlignment.Right
            val.ZIndex = 2
            val.Parent = track

            local function UpdateSlider(input)
                local totalSize = track.AbsoluteSize.X
                local relativeX = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, totalSize)
                local percentage = relativeX / totalSize
                local value = math.round(percentage * max)
                fill.Size = UDim2.new(percentage, 0, 1, 0)
                val.Text = value .. "/" .. max
                pcall(cb, value)
            end

            local activeSliding = false
            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    activeSliding = true
                    UpdateSlider(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if activeSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                      activeSliding = false
                end
            end)
        end

