    BoxFrame.Parent = targetColumn
    BoxFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
    BoxFrame.BorderSizePixel = 1
    BoxFrame.BorderColor3 = Color3.fromRGB(28, 28, 35)
    BoxFrame.Size = UDim2.new(1, 0, 0, 40)
    BoxFrame.ZIndex = 2

    local BoxPadding = Instance.new("UIPadding")
    BoxPadding.Parent = BoxFrame
    BoxPadding.PaddingTop = UDim.new(0, 12)
    BoxPadding.PaddingBottom = UDim.new(0, 8)
    BoxPadding.PaddingLeft = UDim.new(0, 10)
    BoxPadding.PaddingRight = UDim.new(0, 10)

    local BoxList = Instance.new("UIListLayout")
    BoxList.Parent = BoxFrame
    BoxList.SortOrder = Enum.SortOrder.LayoutOrder
    BoxList.Padding = UDim.new(0, 8)

    local LabelContainer = Instance.new("Frame")
    LabelContainer.Parent = BoxFrame
    LabelContainer.BackgroundTransparency = 1
    LabelContainer.Position = UDim2.new(0, -4, 0, -19)
    LabelContainer.Size = UDim2.new(1, 0, 0, 12)
    LabelContainer.ZIndex = 2

    local BoxLabel = Instance.new("TextLabel")
    BoxLabel.Parent = LabelContainer
    BoxLabel.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
    BoxLabel.Text = "  " .. string.upper(title) .. "  "
    BoxLabel.Font = Enum.Font.Arcade
    BoxLabel.TextColor3 = Color3.fromRGB(150, 150, 155)
    BoxLabel.TextSize = 10
    BoxLabel.Size = UDim2.new(0, 0, 1, 0)
    BoxLabel.TextXAlignment = Enum.TextXAlignment.Left
    BoxLabel.AutomaticSize = Enum.AutomaticSize.X
    BoxLabel.ZIndex = 2

    BoxList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        BoxFrame.Size = UDim2.new(1, 0, 0, BoxList.AbsoluteContentSize.Y + 20)
    end)

    local Elements = {}

    function Elements:CreateToggle(name, default, callback)
        local state = default or false
        local Row = Instance.new("Frame")
        Row.Parent = BoxFrame
        Row.BackgroundTransparency = 1
        Row.Size = UDim2.new(1, 0, 0, 14)
        Row.ZIndex = 2

        local BoxBtn = Instance.new("TextButton")
        BoxBtn.Parent = Row
        BoxBtn.Size = UDim2.new(0, 10, 0, 10)
        BoxBtn.Position = UDim2.new(0, 0, 0.5, -5)
        BoxBtn.BackgroundColor3 = state and Color3.fromRGB(130, 85, 230) or Color3.fromRGB(20, 20, 25)
        BoxBtn.BorderColor3 = Color3.fromRGB(45, 45, 52)
        BoxBtn.Text = ""
        BoxBtn.ZIndex = 2

        local Label = Instance.new("TextLabel")
        Label.Parent = Row
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 16, 0, 0)
        Label.Size = UDim2.new(1, -40, 1, 0)
        Label.Font = Enum.Font.Arcade
        Label.Text = name
        Label.TextColor3 = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 155)
        Label.TextSize = 10
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = 2

        local StatusLabel = Instance.new("TextLabel")
        StatusLabel.Parent = Row
        StatusLabel.BackgroundTransparency = 1
        StatusLabel.Position = UDim2.new(1, -24, 0, 0)
        StatusLabel.Size = UDim2.new(0, 24, 1, 0)
        StatusLabel.Font = Enum.Font.Arcade
        StatusLabel.Text = state and "[ON]" or "[OFF]"
        StatusLabel.TextColor3 = state and Color3.fromRGB(130, 85, 230) or Color3.fromRGB(80, 80, 85)
        StatusLabel.TextSize = 9
        StatusLabel.TextXAlignment = Enum.TextXAlignment.Right
        StatusLabel.ZIndex = 2

        local function update()
            BoxBtn.BackgroundColor3 = state and Color3.fromRGB(130, 85, 230) or Color3.fromRGB(20, 20, 25)
            Label.TextColor3 = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 155)
            StatusLabel.Text = state and "[ON]" or "[OFF]"
            StatusLabel.TextColor3 = state and Color3.fromRGB(130, 85, 230) or Color3.fromRGB(80, 80, 85)
            callback(state)
        end
        BoxBtn.MouseButton1Click:Connect(function() state = not state update() end)
    end

    function Elements:CreateSlider(name, min, max, default, symbol, callback)
        local value = default or min
        local sym = symbol or ""
        local Row = Instance.new("Frame")
        Row.Parent = BoxFrame
        Row.BackgroundTransparency = 1
        Row.Size = UDim2.new(1, 0, 0, 24)
        Row.ZIndex = 2

        local Label = Instance.new("TextLabel")
        Label.Parent = Row
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(1, 0, 0, 12)
        Label.Font = Enum.Font.Arcade
        Label.Text = name .. " -> " .. tostring(value) .. sym
        Label.TextColor3 = Color3.fromRGB(150, 150, 155)
        Label.TextSize = 10
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.ZIndex = 2

        local SliderTrack = Instance.new("Frame")
        SliderTrack.Parent = Row
        SliderTrack.Position = UDim2.new(0, 0, 0, 14)
        SliderTrack.Size = UDim2.new(1, 0, 0, 5)
        SliderTrack.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        SliderTrack.BorderColor3 = Color3.fromRGB(38, 38, 45)
        SliderTrack.ZIndex = 2

        local SliderFill = Instance.new("Frame")
        SliderFill.Parent = SliderTrack
        SliderFill.Size = UDim2.new((value - min)/(max - min), 0, 1, 0)
        SliderFill.BackgroundColor3 = Color3.fromRGB(130, 85, 230)
        SliderFill.BorderSizePixel = 0
        SliderFill.ZIndex = 2

        local function updateSlider(input)
            local scale = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * scale)
            Label.Text = name .. " -> " .. tostring(value) .. sym
            SliderFill.Size = UDim2.new(scale, 0, 1, 0)
            callback(value)
        end

        local sliding = false
        SliderTrack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true updateSlider(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
    end

    function Elements:AddDropdown(labelText, defaultSelected, optionsList, callback)
        local cb = callback or function() end

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 12)
        lbl.BackgroundTransparency = 1
        lbl.Text = labelText
        lbl.TextColor3 = Color3.fromRGB(150, 150, 155)
        lbl.Font = Enum.Font.Arcade
        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = BoxFrame
        lbl.ZIndex = 2

        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, 0, 0, 15)
        button.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        button.BorderColor3 = Color3.fromRGB(38, 38, 45)
        button.Text = " " .. (defaultSelected or "Select")
        button.TextColor3 = Color3.fromRGB(200, 200, 205)
        button.Font = Enum.Font.Arcade
        button.TextSize = 10
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.Active = true
        button.Parent = BoxFrame
        button.ZIndex = 2

        local dropdownFrame = Instance.new("Frame")
        dropdownFrame.Size = UDim2.new(1, 0, 0, #optionsList * 15)
        dropdownFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
        dropdownFrame.BorderColor3 = Color3.fromRGB(38, 38, 45)
        dropdownFrame.Visible = false
        dropdownFrame.Active = true
        dropdownFrame.Parent = BoxFrame
        dropdownFrame.ZIndex = 3

        local layout = Instance.new("UIListLayout")
        layout.Parent = dropdownFrame

        for _, option in ipairs(optionsList) do
            local optionBtn = Instance.new("TextButton")
            optionBtn.Size = UDim2.new(1, 0, 0, 15)
            optionBtn.BackgroundTransparency = 1
            optionBtn.Text = "  " .. option
            optionBtn.TextColor3 = Color3.fromRGB(150, 150, 155)
            optionBtn.Font = Enum.Font.Arcade
            optionBtn.TextSize = 9
            optionBtn.TextXAlignment = Enum.TextXAlignment.Left
            optionBtn.Active = true
            optionBtn.Parent = dropdownFrame
            optionBtn.ZIndex = 3

            optionBtn.MouseButton1Click:Connect(function()
                button.Text = " " .. option
                dropdownFrame.Visible = false
                pcall(cb, option)
                BoxFrame.Size = UDim2.new(1, 0, 0, BoxList.AbsoluteContentSize.Y + 20)
            end)
        end

        button.MouseButton1Click:Connect(function()
            dropdownFrame.Visible = not dropdownFrame.Visible
            BoxFrame.Size = UDim2.new(1, 0, 0, BoxList.AbsoluteContentSize.Y + 20)
        end)
    end

    return Elements
end

