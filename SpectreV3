local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

-- Clean up
if CoreGui:FindFirstChild("SpectreV3") then CoreGui.SpectreV3:Destroy() end

local AbyssUI = Instance.new("ScreenGui", CoreGui)
AbyssUI.Name = "SpectreV3"

local MasterScale = Instance.new("UIScale", AbyssUI)
MasterScale.Scale = 0.78

-- UI Framework Object
local UI = { TabCount = 0 }

-- MAIN WINDOW
local MenuFrame = Instance.new("Frame", AbyssUI)
MenuFrame.Size = UDim2.new(0, 440, 0, 340) 
MenuFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
MenuFrame.AnchorPoint = Vector2.new(0.5, 0.5)
MenuFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
MenuFrame.BorderColor3 = Color3.fromRGB(45, 45, 48)
MenuFrame.BorderSizePixel = 1
MenuFrame.Active = true

-- Tabs and Content
local TabsHeader = Instance.new("Frame", MenuFrame)
TabsHeader.Size = UDim2.new(1, -16, 0, 18)
TabsHeader.Position = UDim2.new(0, 8, 0, 8)
TabsHeader.BackgroundTransparency = 1

local ContentContainer = Instance.new("Frame", MenuFrame)
ContentContainer.Size = UDim2.new(1, -16, 1, -40)
ContentContainer.Position = UDim2.new(0, 8, 0, 32)
ContentContainer.BackgroundTransparency = 1

function UI:CreateTab(tabName)
    UI.TabCount += 1
    local isFirst = (UI.TabCount == 1)
    local tabBtn = Instance.new("TextButton", TabsHeader)
    tabBtn.Size = UDim2.new(0, 60, 1, 0)
    tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(24, 24, 28) or Color3.fromRGB(16, 16, 18)
    tabBtn.Text = tabName
    tabBtn.Font = Enum.Font.Arcade
    tabBtn.TextSize = 10
    tabBtn.LayoutOrder = UI.TabCount
    
    local viewFrame = Instance.new("Frame", ContentContainer)
    viewFrame.Size = UDim2.new(1, 0, 1, 0)
    viewFrame.BackgroundTransparency = 1
    viewFrame.Visible = isFirst

    local function CreateSection(pos)
        local box = Instance.new("Frame", viewFrame)
        box.Size = UDim2.new(0.5, -9, 1, -12)
        box.Position = pos
        box.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        Instance.new("UIListLayout", box).Padding = UDim.new(0, 5)
        Instance.new("UIPadding", box).PaddingTop = UDim.new(0, 8)
        return box
    end
    
    local tabObj = { Left = CreateSection(UDim2.new(0, 6, 0, 6)), Right = CreateSection(UDim2.new(0.5, 3, 0, 6)), OrderIndex = 0 }
    tabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(ContentContainer:GetChildren()) do v.Visible = false end
        viewFrame.Visible = true
    end)
    return tabObj
end

-- COMPONENTS
function UI:AddToggle(section, label, default, callback)
    section.OrderIndex += 2
    local lbl = Instance.new("TextLabel", section)
    lbl.Text = label
    lbl.BackgroundTransparency = 1
    local btn = Instance.new("TextButton", lbl)
    btn.Text = "Toggle"
    btn.MouseButton1Click:Connect(function() pcall(callback, true) end)
end

function UI:AddDropdown(section, labelText, defaultSelected, optionsList, callback)
    section.OrderIndex += 2
    local lbl = Instance.new("TextLabel", section)
    lbl.Text = labelText
    lbl.BackgroundTransparency = 1
    
    local box = Instance.new("TextButton", lbl)
    box.Size = UDim2.new(1, 0, 0, 15)
    box.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    box.Text = defaultSelected
    
    box.MouseButton1Click:Connect(function()
        if box:FindFirstChild("OptionList") then box.OptionList:Destroy() return end
        local list = Instance.new("ScrollingFrame", box)
        list.Name = "OptionList"
        list.Size = UDim2.new(1, 0, 0, math.min(#optionsList * 17, 120))
        list.Position = UDim2.new(0, 0, 0, -2)
        list.AnchorPoint = Vector2.new(0, 1)
        list.ZIndex = 20
        Instance.new("UIListLayout", list)
        
        for _, v in ipairs(optionsList) do
            local item = Instance.new("TextButton", list)
            item.Size = UDim2.new(1, 0, 0, 17)
            item.Text = v
            item.ZIndex = 21
            item.MouseButton1Click:Connect(function()
                box.Text = v
                pcall(callback, v)
                list:Destroy()
            end)
        end
    end)
end

return UI
