local UI = {
    Tabs = {},
    ActiveTab = nil,
    TabCount = 0
}

function UI:CreateTab(tabName)
    UI.TabCount = UI.TabCount + 1
    local isFirst = (UI.TabCount == 1)

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 60, 1, 0)
    tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(24, 24, 28) or Color3.fromRGB(16, 16, 18)
    tabBtn.BorderColor3 = Color3.fromRGB(35, 35, 38)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 145)
    tabBtn.Font = Enum.Font.Arcade
    tabBtn.TextSize = 10 
    tabBtn.LayoutOrder = UI.TabCount
    tabBtn.Parent = TabsHeader

    local viewFrame = Instance.new("Frame")
    viewFrame.Size = UDim2.new(1, 0, 1, 0)
    viewFrame.BackgroundTransparency = 1
    viewFrame.Visible = isFirst
    viewFrame.Parent = ContentContainer

    local function CreateSection(pos)
        local box = Instance.new("Frame")
        box.Size = UDim2.new(0.5, -9, 1, -12)
        box.Position = pos
        box.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        box.BorderColor3 = Color3.fromRGB(32, 32, 35)
        box.BorderSizePixel = 1
        box.Parent = viewFrame

        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 5)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = box

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)
        pad.Parent = box

        return box
    end

    local leftSection = CreateSection(UDim2.new(0, 6, 0, 6))
    local rightSection = CreateSection(UDim2.new(0.5, 3, 0, 6))

    local tabObj = { Left = leftSection, Right = rightSection, Button = tabBtn, Frame = viewFrame, OrderIndex = 1 }

    if isFirst then UI.ActiveTab = tabObj end

    tabBtn.MouseButton1Click:Connect(function()
        if UI.ActiveTab then
            UI.ActiveTab.Button.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
            UI.ActiveTab.Button.TextColor3 = Color3.fromRGB(140, 140, 145)
            UI.ActiveTab.Frame.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        viewFrame.Visible = true
        UI.ActiveTab = tabObj
    end)
    return tabObj
end

function UI:AddToggle(section, labelText, defaultState, callback)
    section.OrderIndex = section.OrderIndex + 2
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 13)
    btn.BackgroundTransparency = 1
    btn.Text = "   " .. labelText
    btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 10 
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = section.OrderIndex
    btn.Parent = section.Left and section.Left or section

    local check = Instance.new("Frame", btn)
    check.Size = UDim2.new(0, 7, 0, 7)
    check.Position = UDim2.new(0, 0, 0.5, -4)
    check.BackgroundColor3 = defaultState and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
    
    local active = defaultState
    btn.MouseButton1Click:Connect(function()
        active = not active
        check.BackgroundColor3 = active and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
        btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
        pcall(callback, active)
    end)
end

function UI:AddDropdown(section, labelText, defaultSelected, optionsList, callback)
    section.OrderIndex = section.OrderIndex + 2
    local lbl = Instance.new("TextLabel", section.Left or section)
    lbl.Size = UDim2.new(1, 0, 0, 11); lbl.BackgroundTransparency = 1; lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200); lbl.Font = Enum.Font.Arcade; lbl.TextSize = 10; lbl.TextXAlignment = 0; lbl.LayoutOrder = section.OrderIndex

    local box = Instance.new("TextButton", lbl)
    box.Size = UDim2.new(1, 0, 0, 15); box.BackgroundColor3 = Color3.fromRGB(12, 12, 14); box.BorderColor3 = Color3.fromRGB(32, 32, 35); box.LayoutOrder = section.OrderIndex + 1; box.Text = ""

    local txt = Instance.new("TextLabel", box)
    txt.Size = UDim2.new(1, -6, 1, 0); txt.Position = UDim2.new(0, 4, 0, 0); txt.BackgroundTransparency = 1; txt.Text = defaultSelected
    txt.TextColor3 = Color3.fromRGB(140, 140, 145); txt.Font = Enum.Font.Arcade; txt.TextSize = 9; txt.TextXAlignment = 0

    box.MouseButton1Click:Connect(function()
        if box:FindFirstChild("List") then box.List:Destroy() return end
        local list = Instance.new("ScrollingFrame", box)
        list.Name = "List"; list.Size = UDim2.new(1, 0, 0, math.min(#optionsList * 17, 100)); list.Position = UDim2.new(0, 0, 1, 2)
        list.BackgroundColor3 = Color3.fromRGB(20, 20, 22); list.BorderColor3 = Color3.fromRGB(45, 45, 48); list.ScrollBarThickness = 2; list.ZIndex = 10
        Instance.new("UIListLayout", list)
        for _, v in ipairs(optionsList) do
            local item = Instance.new("TextButton", list)
            item.Size = UDim2.new(1, 0, 0, 17); item.Text = v; item.TextColor3 = Color3.fromRGB(200, 200, 200); item.Font = Enum.Font.Arcade; item.TextSize = 9; item.ZIndex = 11
            item.MouseButton1Click:Connect(function() txt.Text = v; pcall(callback, v); list:Destroy() end)
        end
    end)
end

