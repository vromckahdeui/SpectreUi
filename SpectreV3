-- Tabs and Content
local TabsHeader = Instance.new("Frame", MenuFrame)
TabsHeader.Size = UDim2.new(1, -16, 0, 18)
TabsHeader.Position = UDim2.new(0, 8, 0, 8)
TabsHeader.BackgroundTransparency = 1

local ContentContainer = Instance.new("Frame", MenuFrame)
ContentContainer.Size = UDim2.new(1, -16, 1, -40)
ContentContainer.Position = UDim2.new(0, 8, 0, 32)
ContentContainer.BackgroundTransparency = 1

local UI = { TabCount = 0 }

function UI:CreateTab(tabName)
    UI.TabCount = UI.TabCount + 1
    local isFirst = (UI.TabCount == 1)

    local tabBtn = Instance.new("TextButton", TabsHeader)
    tabBtn.Size = UDim2.new(0, 60, 1, 0)
    tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(24, 24, 28) or Color3.fromRGB(16, 16, 18)
    tabBtn.Text = tabName
    tabBtn.Font = Enum.Font.Arcade
    tabBtn.TextSize = 10 
    tabBtn.LayoutOrder = UI.TabCount

    local viewFrame = Instance.new("Frame", ContentContainer)
    viewFrame.Size = UDim2.new(1, 0, 1, 0)
    viewFrame.BackgroundTransparency = 1
    viewFrame.Visible = isFirst

    local function CreateSection(pos)
        local box = Instance.new("Frame", viewFrame)
        box.Size = UDim2.new(0.5, -9, 1, -12)
        box.Position = pos
        box.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        Instance.new("UIListLayout", box).Padding = UDim.new(0, 5)
        Instance.new("UIPadding", box).PaddingTop = UDim.new(0, 8)
        return box
    end

    local tabObj = { Left = CreateSection(UDim2.new(0, 6, 0, 6)), Right = CreateSection(UDim2.new(0.5, 3, 0, 6)), OrderIndex = 0 }
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(ContentContainer:GetChildren()) do v.Visible = false end
        viewFrame.Visible = true
    end)
    return tabObj
end

-- COMPONENTS
function UI:AddToggle(section, labelText, default, callback)
    section.OrderIndex += 2
    local lbl = Instance.new("TextLabel", section)
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    local btn = Instance.new("TextButton", lbl)
    btn.Text = "Toggle"
    btn.MouseButton1Click:Connect(function() pcall(callback, true) end)
end

function UI:AddDropdown(section, labelText, default, options, callback)
    section.OrderIndex += 2
    local lbl = Instance.new("TextLabel", section)
    lbl.Text = labelText
    lbl.Size = UDim2.new(1, 0, 0, 20)
    
    local box = Instance.new("TextButton", lbl)
    box.Size = UDim2.new(1, 0, 0, 15)
    box.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    box.Text = default
    
    box.MouseButton1Click:Connect(function()
        if box:FindFirstChild("Popup") then box.Popup:Destroy() return end
        
        local pop = Instance.new("ScrollingFrame", box)
        pop.Name = "Popup"
        pop.Size = UDim2.new(1, 0, 0, #options * 20)
        pop.Position = UDim2.new(0, 0, 1, 0)
        pop.ZIndex = 10
        Instance.new("UIListLayout", pop)
        
        for _, opt in ipairs(options) do
            local item = Instance.new("TextButton", pop)
            item.Size = UDim2.new(1, 0, 0, 20)
            item.Text = opt
            item.MouseButton1Click:Connect(function()
                box.Text = opt
                pcall(callback, opt)
                pop:Destroy()
            end)
        end
    end)
end

return UI
