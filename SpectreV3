local UI = { Tabs = {}, ActiveTab = nil, TabCount = 0 }

function UI:CreateTab(tabName)
    UI.TabCount = UI.TabCount + 1
    local isFirst = (UI.TabCount == 1)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 60, 1, 0)
    tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(24, 24, 28) or Color3.fromRGB(16, 16, 18)
    tabBtn.BorderColor3 = Color3.fromRGB(35, 35, 38)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 145)
    tabBtn.Font = Enum.Font.Arcade
    tabBtn.TextSize = 10 
    tabBtn.LayoutOrder = UI.TabCount
    tabBtn.Parent = TabsHeader

    local viewFrame = Instance.new("Frame")
    viewFrame.Size = UDim2.new(1, 0, 1, 0)
    viewFrame.BackgroundTransparency = 1
    viewFrame.Visible = isFirst
    viewFrame.Parent = ContentContainer

    local function CreateSection(pos)
        local box = Instance.new("Frame")
        box.Size = UDim2.new(0.5, -9, 1, -12)
        box.Position = pos
        box.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        box.BorderColor3 = Color3.fromRGB(32, 32, 35)
        box.BorderSizePixel = 1
        box.Parent = viewFrame
        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 5)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = box
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)
        pad.Parent = box
        return box
    end

    local tabObj = { Left = CreateSection(UDim2.new(0, 6, 0, 6)), Right = CreateSection(UDim2.new(0.5, 3, 0, 6)), Button = tabBtn, Frame = viewFrame, OrderIndex = 1 }
    if isFirst then UI.ActiveTab = tabObj end
    tabBtn.MouseButton1Click:Connect(function()
        if UI.ActiveTab then
            UI.ActiveTab.Button.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
            UI.ActiveTab.Button.TextColor3 = Color3.fromRGB(140, 140, 145)
            UI.ActiveTab.Frame.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        viewFrame.Visible = true
        UI.ActiveTab = tabObj
    end)
    return tabObj
end

function UI:AddToggle(section, labelText, defaultState, callback)
    section.OrderIndex = section.OrderIndex + 2
    local cb = callback or function() end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 10 
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = section.OrderIndex
    lbl.Parent = section
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 13)
    btn.BackgroundTransparency = 1
    btn.Text = "   Enabled"
    btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 10 
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = section.OrderIndex + 1
    btn.Parent = lbl.Parent
    local check = Instance.new("Frame")
    check.Size = UDim2.new(0, 7, 0, 7)
    check.Position = UDim2.new(0, 0, 0.5, -4)
    check.BackgroundColor3 = defaultState and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
    check.BorderColor3 = Color3.fromRGB(50, 50, 55)
    check.Parent = btn
    local active = defaultState
    btn.MouseButton1Click:Connect(function()
        active = not active
        check.BackgroundColor3 = active and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
        btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
        pcall(cb, active)
    end)
end

function UI:AddDropdown(section, labelText, defaultSelected, optionsList, callback)
    section.OrderIndex = section.OrderIndex + 2
    local cb = callback or function() end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
