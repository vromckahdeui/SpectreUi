    lbl.LayoutOrder = section.OrderIndex
    lbl.Parent = section
    local box = Instance.new("TextButton")
    box.Size = UDim2.new(1, 0, 0, 15)
    box.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    box.BorderColor3 = Color3.fromRGB(32, 32, 35)
    box.LayoutOrder = section.OrderIndex + 1
    box.Text = ""
    box.Parent = lbl.Parent
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -6, 1, 0)
    txt.Position = UDim2.new(0, 4, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = defaultSelected
    txt.TextColor3 = Color3.fromRGB(140, 140, 145)
    txt.Font = Enum.Font.Arcade
    txt.TextSize = 9 
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.Parent = box
    box.MouseButton1Click:Connect(function()
        if box:FindFirstChild("ListContainer") then box.ListContainer:Destroy() return end
        local list = Instance.new("ScrollingFrame")
        list.Name = "ListContainer"
        list.Size = UDim2.new(1, 0, 0, math.min(#optionsList * 17, 100))
        list.Position = UDim2.new(0, 0, 1, 2)
        list.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
        list.BorderColor3 = Color3.fromRGB(35, 35, 38)
        list.CanvasSize = UDim2.new(0, 0, 0, #optionsList * 17)
        list.ScrollBarThickness = 2
        list.ZIndex = 10
        list.Parent = box
        local layout = Instance.new("UIListLayout")
        layout.Parent = list
        for _, v in ipairs(optionsList) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, 0, 0, 17)
            item.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
            item.Text = v
            item.TextColor3 = Color3.fromRGB(200, 200, 200)
            item.Font = Enum.Font.Arcade
            item.TextSize = 9
            item.ZIndex = 11
            item.Parent = list
            item.MouseButton1Click:Connect(function()
                txt.Text = v
                pcall(cb, v)
                list:Destroy()
            end)
        end
    end)
end

function UI:AddSlider(section, labelText, current, max, callback)
    section.OrderIndex = section.OrderIndex + 2
    local cb = callback or function() end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 10 
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = section.OrderIndex
    lbl.Parent = section
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 9)
    track.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    track.BorderColor3 = Color3.fromRGB(32, 32, 35)
    track.LayoutOrder = section.OrderIndex + 1
    track.Parent = lbl.Parent
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(current/max, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(48, 110, 160)
    fill.BorderSizePixel = 0
    fill.Parent = track
    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(1, -4, 1, 0)
    val.BackgroundTransparency = 1
    val.Text = current .. "/" .. max
    val.TextColor3 = Color3.fromRGB(150, 150, 155)
    val.Font = Enum.Font.Arcade
    val.TextSize = 9 
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = track
    local function UpdateSlider(input)
        local totalSize = track.AbsoluteSize.X
        local relativeX = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, totalSize)
        local percentage = relativeX / totalSize
        local value = math.round(percentage * max)
        fill.Size = UDim2.new(percentage, 0, 1, 0)
        val.Text = value .. "/" .. max
        pcall(cb, value)
    end
    local activeSliding = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliding = true
            UpdateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if activeSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliding = false
        end
    end)
end

