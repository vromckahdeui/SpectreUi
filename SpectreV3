-- ====================================================
-- SMOOTHED INTERACTION DRIVERS
-- ====================================================
local menuVisible = true
FloatingToggle.MouseButton1Click:Connect(function()
    menuVisible = not menuVisible
    MenuFrame.Visible = menuVisible
    FloatingToggle.Text = menuVisible and "[x] TOGGLE" or "[ ] TOGGLE"
    FloatingToggle.TextColor3 = menuVisible and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(140, 140, 145)
end)

local dragging, dragStart, startPos
MenuFrame.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UserInputService:GetFocusedTextBox() == nil then
        if input.Position.Y - MenuFrame.AbsolutePosition.Y <= (30 * MasterScale.Scale) then
            dragging = true
            dragStart = input.Position
            startPos = MenuFrame.AbsolutePosition
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MenuFrame.Position = UDim2.new(0, startPos.X + (delta.X / MasterScale.Scale) + (MenuFrame.Size.X.Offset * MenuFrame.AnchorPoint.X), 0, startPos.Y + (delta.Y / MasterScale.Scale) + (MenuFrame.Size.Y.Offset * MenuFrame.AnchorPoint.Y))
    end
end)

local resizing, resizeStart, startSize
ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resizeStart = input.Position
        startSize = MenuFrame.Size
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then resizing = false end end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - resizeStart
        local rawNewWidth = startSize.X.Offset + (delta.X / MasterScale.Scale)
        local rawNewHeight = startSize.Y.Offset + (delta.Y / MasterScale.Scale)
        local clampedWidth = math.clamp(rawNewWidth, 340, 750)
        local clampedHeight = math.clamp(rawNewHeight, 260, 550)
        MenuFrame.Size = UDim2.new(0, clampedWidth, 0, clampedHeight)
    end
end)

return UI
