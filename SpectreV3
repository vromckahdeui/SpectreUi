local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

if CoreGui:FindFirstChild("SpectreV3") then CoreGui.SpectreV3:Destroy() end

local AbyssUI = Instance.new("ScreenGui", CoreGui)
AbyssUI.Name = "SpectreV3"

local UI = { TabCount = 0 }
local MenuFrame = Instance.new("Frame", AbyssUI)
MenuFrame.Size = UDim2.new(0, 440, 0, 340); MenuFrame.Position = UDim2.new(0.5, 0, 0.5, 0); MenuFrame.AnchorPoint = Vector2.new(0.5, 0.5); MenuFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 22); MenuFrame.Active = true

local TabsHeader = Instance.new("Frame", MenuFrame); TabsHeader.Size = UDim2.new(1, -16, 0, 18); TabsHeader.Position = UDim2.new(0, 8, 0, 8); TabsHeader.BackgroundTransparency = 1
local ContentContainer = Instance.new("Frame", MenuFrame); ContentContainer.Size = UDim2.new(1, -16, 1, -40); ContentContainer.Position = UDim2.new(0, 8, 0, 32); ContentContainer.BackgroundTransparency = 1

function UI:CreateTab(tabName)
    UI.TabCount += 1
    local isFirst = (UI.TabCount == 1)
    local tabBtn = Instance.new("TextButton", TabsHeader); tabBtn.Size = UDim2.new(0, 60, 1, 0); tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(24, 24, 28) or Color3.fromRGB(16, 16, 18); tabBtn.Text = tabName; tabBtn.Font = Enum.Font.Arcade; tabBtn.TextSize = 10
    local viewFrame = Instance.new("Frame", ContentContainer); viewFrame.Size = UDim2.new(1, 0, 1, 0); viewFrame.BackgroundTransparency = 1; viewFrame.Visible = isFirst
    
    local function CreateSection(pos)
        local box = Instance.new("Frame", viewFrame); box.Size = UDim2.new(0.5, -9, 1, -12); box.Position = pos; box.BackgroundColor3 = Color3.fromRGB(17, 17, 19)
        Instance.new("UIListLayout", box).Padding = UDim.new(0, 5)
        Instance.new("UIPadding", box).PaddingTop = UDim.new(0, 8); Instance.new("UIPadding", box).PaddingLeft = UDim.new(0, 8); Instance.new("UIPadding", box).PaddingRight = UDim.new(0, 8)
        return box
    end
    
    local tabObj = { Left = CreateSection(UDim2.new(0, 6, 0, 6)), Right = CreateSection(UDim2.new(0.5, 3, 0, 6)) }
    tabBtn.MouseButton1Click:Connect(function() for _, v in pairs(ContentContainer:GetChildren()) do v.Visible = false end; viewFrame.Visible = true end)
    return tabObj
end

function UI:AddDropdown(section, labelText, defaultSelected, optionsList, callback)
    local lbl = Instance.new("TextLabel", section); lbl.Size = UDim2.new(1, 0, 0, 11); lbl.BackgroundTransparency = 1; lbl.Text = labelText; lbl.TextColor3 = Color3.fromRGB(200, 200, 200); lbl.Font = Enum.Font.Arcade; lbl.TextSize = 10; lbl.TextXAlignment = 0
    local box = Instance.new("TextButton", section); box.Size = UDim2.new(1, 0, 0, 15); box.BackgroundColor3 = Color3.fromRGB(12, 12, 14); box.Text = defaultSelected; box.TextColor3 = Color3.fromRGB(140, 140, 145); box.Font = Enum.Font.Arcade; box.TextSize = 9
    
    box.MouseButton1Click:Connect(function()
        if box:FindFirstChild("List") then box.List:Destroy() return end
        local list = Instance.new("ScrollingFrame", box); list.Name = "List"; list.Size = UDim2.new(1, 0, 0, math.min(#optionsList * 17, 100)); list.Position = UDim2.new(0, 0, 0, -2); list.AnchorPoint = Vector2.new(0, 1); list.BackgroundColor3 = Color3.fromRGB(20, 20, 22); list.ZIndex = 20
        Instance.new("UIListLayout", list)
        for _, v in ipairs(optionsList) do
            local item = Instance.new("TextButton", list); item.Size = UDim2.new(1, 0, 0, 17); item.Text = v; item.TextColor3 = Color3.fromRGB(200, 200, 200); item.Font = Enum.Font.Arcade; item.TextSize = 9; item.ZIndex = 21
            item.MouseButton1Click:Connect(function() box.Text = v; pcall(callback, v); list:Destroy() end)
        end
    end)
end

return UI
