function UI:AddToggle(section, labelText, defaultState, callback)
    section.OrderIndex = section.OrderIndex + 2
    local cb = callback or function() end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 10 
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = section.OrderIndex
    lbl.Parent = section

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 13)
    btn.BackgroundTransparency = 1
    btn.Text = "   Enabled"
    btn.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
    btn.Font = Enum.Font.Arcade
    btn.TextSize = 10 
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = section.OrderIndex + 1
    btn.Parent = lbl.Parent

    local check = Instance.new("Frame")
    check.Size = UDim2.new(0, 7, 0, 7)
    check.Position = UDim2.new(0, 0, 0.5, -4)
    check.BackgroundColor3 = defaultState and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
    check.BorderColor3 = Color3.fromRGB(50, 50, 55)
    check.Parent = btn

    local active = defaultState
    btn.MouseButton1Click:Connect(function()
        active = not active
        check.BackgroundColor3 = active and Color3.fromRGB(48, 110, 160) or Color3.fromRGB(28, 28, 32)
        btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 135)
        pcall(cb, active)
    end)
end

function UI:AddSlider(section, labelText, current, max, callback)
    section.OrderIndex = section.OrderIndex + 2
    local cb = callback or function() end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 10 
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = section.OrderIndex
    lbl.Parent = section

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 9)
    track.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    track.BorderColor3 = Color3.fromRGB(32, 32, 35)
    track.LayoutOrder = section.OrderIndex + 1
    track.Parent = lbl.Parent

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(current/max, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(48, 110, 160)
    fill.BorderSizePixel = 0
    fill.Parent = track

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(1, -4, 1, 0)
    val.BackgroundTransparency = 1
    val.Text = current .. "/" .. max
    val.TextColor3 = Color3.fromRGB(150, 150, 155)
    val.Font = Enum.Font.Arcade
    val.TextSize = 9 
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = track

    local function UpdateSlider(input)
        local totalSize = track.AbsoluteSize.X
        local relativeX = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, totalSize)
        local percentage = relativeX / totalSize
        local value = math.round(percentage * max)
        fill.Size = UDim2.new(percentage, 0, 1, 0)
        val.Text = value .. "/" .. max
        pcall(cb, value)
    end

    local activeSliding = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliding = true
            UpdateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if activeSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeSliding = false
        end
    end)
end

function UI:AddDropdown(section, labelText, defaultSelected, optionsList, callback)
    local cb = callback or function() end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 11)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    lbl.Font = Enum.Font.Arcade
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = section

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 15)
    button.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    button.BorderColor3 = Color3.fromRGB(32, 32, 35)
    button.Text = defaultSelected or "Select"
    button.TextColor3 = Color3.fromRGB(140, 140, 145)
    button.Font = Enum.Font.Arcade
    button.TextSize = 9
    button.Parent = section

    local dropdownFrame = Instance.new("Frame")
    dropdownFrame.Size = UDim2.new(1, 0, 0, #optionsList * 15)
    dropdownFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
    dropdownFrame.BorderColor3 = Color3.fromRGB(32, 32, 35)
    dropdownFrame.Visible = false
    dropdownFrame.Parent = section

    local layout = Instance.new("UIListLayout")
    layout.Parent = dropdownFrame

    for _, option in ipairs(optionsList) do
        local optionBtn = Instance.new("TextButton")
        optionBtn.Size = UDim2.new(1, 0, 0, 15)
        optionBtn.BackgroundTransparency = 1
        optionBtn.Text = option
        optionBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        optionBtn.Font = Enum.Font.Arcade
        optionBtn.TextSize = 9
        optionBtn.Parent = dropdownFrame

        optionBtn.MouseButton1Click:Connect(function()
            button.Text = option
            dropdownFrame.Visible = false
            pcall(cb, option)
        end)
    end

    button.MouseButton1Click:Connect(function()
        dropdownFrame.Visible = not dropdownFrame.Visible
    end)
end

