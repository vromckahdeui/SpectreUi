-- Function to create a custom slider control
local function createCustomSlider(parent, name, labelText, initialValue, minValue, maxValue, unitText)
    local Frame = Instance.new("Frame")
    Frame.Name = name .. "Frame"
    Frame.Size = UDim2.new(1, 0, 0, 35) -- Height adjusted for slider and value
    Frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Frame.BackgroundTransparency = 1
    Frame.Parent = parent

    local Label = Instance.new("TextLabel")
    Label.Name = "Label"
    Label.Size = UDim2.new(0.4, 0, 0.5, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.SourceSans
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextYAlignment = Enum.TextYAlignment.Center
    Label.Parent = Frame

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Name = "Value"
    ValueLabel.Size = UDim2.new(0.4, 0, 0.5, 0)
    ValueLabel.Position = UDim2.new(0.6, 0, 0, 0)
    ValueLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Font = Enum.Font.SourceSans
    ValueLabel.Text = tostring(initialValue) .. "/" .. tostring(maxValue) .. unitText
    ValueLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    ValueLabel.TextSize = 12
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.TextYAlignment = Enum.TextYAlignment.Center
    ValueLabel.Parent = Frame

    local SliderFrame = Instance.new("Frame")
    SliderFrame.Name = "SliderFrame"
    SliderFrame.Size = UDim2.new(0.9, 0, 0, 5) -- Thin slider bar
    SliderFrame.Position = UDim2.new(0.5, 0, 0.75, 0)
    SliderFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    SliderFrame.BorderColor3 = Color3.fromRGB(50, 50, 50)
    SliderFrame.BorderSizePixel = 1
    SliderFrame.Parent = Frame

    local SliderFill = Instance.new("Frame")
    SliderFill.Name = "Fill"
    SliderFill.Size = UDim2.new((initialValue - minValue) / (maxValue - minValue), 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderFrame

    local SliderHandle = Instance.new("Frame")
    SliderHandle.Name = "Handle"
    SliderHandle.Size = UDim2.new(0, 10, 0, 10)
    SliderHandle.Position = UDim2.new((initialValue - minValue) / (maxValue - minValue), 0, 0.5, 0)
    SliderHandle.AnchorPoint = Vector2.new(0.5, 0.5)
    SliderHandle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderHandle.BorderColor3 = Color3.fromRGB(50, 50, 50)
    SliderHandle.BorderSizePixel = 1
    SliderHandle.Parent = SliderFrame

    local draggingSlider = false
    local sliderStartPos = Vector2.new(0, 0)
    local sliderInitialFill = 0

    SliderHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            sliderStartPos = input.Position
            sliderInitialFill = SliderFill.Size.X.Scale
            input.Handled = true
        end
    end)

    SliderHandle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    PlayerGui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSlider then
                local delta = input.Position - sliderStartPos
                local newFillScale = math.clamp(sliderInitialFill + (delta.X / SliderFrame.AbsoluteSize.X), 0, 1)
                SliderFill.Size = UDim2.new(newFillScale, 0, 1, 0)
                SliderHandle.Position = UDim2.new(newFillScale, 0, 0.5, 0)

                local currentValue = minValue + (newFillScale * (maxValue - minValue))
                ValueLabel.Text = tostring(math.floor(currentValue)) .. "/" .. tostring(maxValue) .. unitText
            end
        end
    end)

    return Frame, Label, ValueLabel, SliderFrame, SliderFill, SliderHandle
end

