-- Tab switching logic
local currentTabContent = CombatColumnLeft.Parent -- ContentFrame holds both columns
local currentIndicator = combatIndicator
local currentIcon = combatIcon
local currentText = combatText

local function switchTab(newTabContent, newIndicator, newIcon, newText)
    -- Hide current content (both columns)
    if currentTabContent then
        for _, child in ipairs(currentTabContent:GetChildren()) do
            if child:IsA("Frame") and (child.Name == "CombatColumnLeft" or child.Name == "CombatColumnRight") then
                child.Visible = false
            end
        end
    end
    if currentIndicator then
        currentIndicator.Visible = false
    end
    if currentIcon then
        currentIcon.ImageColor3 = Color3.fromRGB(150, 150, 150)
    end
    if currentText then
        currentText.TextColor3 = Color3.fromRGB(150, 150, 150)
    end

    -- Show new content (for now, only Combat is populated)
    if newTabContent then
        for _, child in ipairs(newTabContent:GetChildren()) do
            if child:IsA("Frame") and (child.Name == "CombatColumnLeft" or child.Name == "CombatColumnRight") then
                child.Visible = true
            end
        end
    end
    newIndicator.Visible = true
    newIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    newText.TextColor3 = Color3.fromRGB(255, 255, 255)

    currentTabContent = newTabContent
    currentIndicator = newIndicator
    currentIcon = newIcon
    currentText = newText
end

