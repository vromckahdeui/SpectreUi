    TabButton.Name = name .. "TabButton"
    TabButton.Size = UDim2.new(1, 0, 1, 0)
    TabButton.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
    TabButton.BackgroundTransparency = 1
    TabButton.Parent = parentFrame

    local Icon = Instance.new("ImageLabel")
    Icon.Name = "Icon"
    Icon.Size = UDim2.new(0, 24, 0, 24)
    Icon.Position = UDim2.new(0.5, 0, 0.3, 0)
    Icon.AnchorPoint = Vector2.new(0.5, 0.5)
    Icon.BackgroundTransparency = 1
    Icon.Image = iconAssetId
    Icon.ImageColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
    Icon.Parent = TabButton

    local TabText = Instance.new("TextLabel")
    TabText.Name = "Text"
