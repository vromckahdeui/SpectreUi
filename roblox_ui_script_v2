-- Update tab switching logic to handle two columns for Combat and single frames for others
local function switchTab(newTabContentFrame, newIndicator, newIcon, newText)
    -- Hide current content
    if currentTabContent then
        if currentTabContent.Name == "ContentFrame" then -- If it's the main ContentFrame (for Combat)
            CombatColumnLeft.Visible = false
            CombatColumnRight.Visible = false
        else -- For other single-frame tabs
            currentTabContent.Visible = false
        end
    end
    if currentIndicator then
        currentIndicator.Visible = false
    end
    if currentIcon then
        currentIcon.ImageColor3 = Color3.fromRGB(150, 150, 150)
    end
    if currentText then
        currentText.TextColor3 = Color3.fromRGB(150, 150, 150)
    end

    -- Show new content
    if newTabContentFrame.Name == "ContentFrame" then -- If switching to Combat tab
        CombatColumnLeft.Visible = true
        CombatColumnRight.Visible = true
    else -- For other single-frame tabs
        newTabContentFrame.Visible = true
    end
    newIndicator.Visible = true
    newIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    newText.TextColor3 = Color3.fromRGB(255, 255, 255)

    currentTabContent = newTabContentFrame
    currentIndicator = newIndicator
    currentIcon = newIcon
    currentText = newText
end

